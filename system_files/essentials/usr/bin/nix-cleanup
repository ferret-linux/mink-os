#!/usr/bin/env bash
set -euo pipefail

if ! command -v nix &>/dev/null; then
    echo "nix not found in PATH" >&2
    exit 1
fi

gum style \
    --border rounded \
    --border-foreground 212 \
    --padding "0 1" \
    "$(gum style --foreground 212 --bold 'nix cleanup')" \
    "" \
    "Running:" \
    "  • nix profile wipe-history" \
    "  • nix-env --delete-generations old" \
    "  • nix store gc" \
    "  • nix-collect-garbage -d" \
    "  • nix store optimise"

echo

# ── step 1: profile history ────────────────────────────────────────────────────
gum spin --spinner dot --title "Wiping old profile generations..." -- \
    nix profile wipe-history
gum log --level info "Profile history wiped"

# ── step 2: legacy nix-env generations ─────────────────────────────────────────
gum spin --spinner dot --title "Removing old nix-env generations..." -- \
    nix-env --delete-generations old
gum log --level info "Old nix-env generations removed"

# ── step 3: store gc ───────────────────────────────────────────────────────────
_tmp=$(mktemp)
gum spin --spinner dot --title "Collecting garbage from store..." -- \
    bash -c "nix store gc > '$_tmp' 2>&1"
gum log --level info "$(tail -1 "$_tmp")"
rm -f "$_tmp"

# ── step 4: nix-collect-garbage safety net ─────────────────────────────────────
_tmp=$(mktemp)
gum spin --spinner dot --title "Sweeping remaining profiles (nix-collect-garbage)..." -- \
    bash -c "nix-collect-garbage -d > '$_tmp' 2>&1"
gum log --level info "$(tail -1 "$_tmp")"
rm -f "$_tmp"

# ── step 5: store optimise ─────────────────────────────────────────────────────
_tmp=$(mktemp)
gum spin --spinner dot --title "Optimising store (deduplicating)..." -- \
    bash -c "nix store optimise > '$_tmp' 2>&1"
gum log --level info "$(grep -i 'hard link' "$_tmp" | tail -1 || echo 'optimisation complete')"
rm -f "$_tmp"

echo
gum style --foreground 212 --bold "  Done"