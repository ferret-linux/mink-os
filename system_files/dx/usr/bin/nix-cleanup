#!/usr/bin/env bash
set -euo pipefail

if ! command -v nix &>/dev/null; then
    echo "nix not found in PATH" >&2
    exit 1
fi

# ── gather summary ─────────────────────────────────────────────────────────────
profile_count=$(nix profile wipe-history --dry-run 2>&1 | grep -c "removing profile version" || true)
gc_preview=$(nix store gc --dry-run 2>&1 | tail -1)
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/nix"
cache_size=$(du -sh "$cache_dir" 2>/dev/null | cut -f1 || echo "0K")
cache_empty=true
[[ -d "$cache_dir" ]] && [[ -n "$(ls -A "$cache_dir" 2>/dev/null)" ]] && cache_empty=false

# ── early exit if nothing to do ───────────────────────────────────────────────
if [[ "$profile_count" -eq 0 ]] && [[ "$gc_preview" == "0 store paths would be deleted" ]] && [[ "$cache_empty" == "true" ]]; then
    gum log --level info "Nothing to clean up — running store optimise"
    _tmp=$(mktemp)
    gum spin --spinner dot --title "Optimising store (deduplicating)..." -- \
        bash -c "nix store optimise > '$_tmp' 2>&1"
    gum log --level info "$(grep -i 'hard link' "$_tmp" | tail -1 || echo 'optimisation complete')"
    rm -f "$_tmp"
    exit 0
fi

# ── show what will happen ──────────────────────────────────────────────────────
gum style \
    --border rounded \
    --border-foreground 212 \
    --padding "0 1" \
    "$(gum style --foreground 212 --bold 'nix cleanup')" \
    "" \
    "Profile generations to remove : $(gum style --foreground 196 "$profile_count")" \
    "Flake cache to clear          : $(gum style --foreground 196 "$cache_size")" \
    "Store GC                      : $(gum style --foreground 196 "$gc_preview")" \
    "Store optimise                : $(gum style --foreground 196 "will run after GC")"

gum confirm "Proceed?" || { echo "Aborted."; exit 0; }
echo

# ── step 1: profile history ────────────────────────────────────────────────────
gum spin --spinner dot --title "Wiping old profile generations..." -- \
    nix profile wipe-history
gum log --level info "Removed ${profile_count} old profile generation(s)"

# ── step 2: flake cache ────────────────────────────────────────────────────────
gum spin --spinner dot --title "Clearing flake cache (${cache_size})..." -- \
    bash -c "rm -rf '${cache_dir:?}/'*"
gum log --level info "Flake cache cleared"

# ── step 3: store gc ───────────────────────────────────────────────────────────
_tmp=$(mktemp)
gum spin --spinner dot --title "Collecting garbage from store..." -- \
    bash -c "nix store gc > '$_tmp' 2>&1"
gum log --level info "$(tail -1 "$_tmp")"
rm -f "$_tmp"

# ── step 4: store optimise ─────────────────────────────────────────────────────
_tmp=$(mktemp)
gum spin --spinner dot --title "Optimising store (deduplicating)..." -- \
    bash -c "nix store optimise > '$_tmp' 2>&1"
gum log --level info "$(grep -i 'hard link' "$_tmp" | tail -1 || echo 'optimisation complete')"
rm -f "$_tmp"

echo
gum style --foreground 212 --bold "  Done"